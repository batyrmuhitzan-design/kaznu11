# =====================================================================
# NodeBB 试跑栈配置 —— 复制成 .env 后使用（.env 不入库）
#   cp -n deploy/nodebb/.env.example deploy/nodebb/.env
# =====================================================================

# 端口：只绑本机回环；公网入口由已有的 openresty 反代（不要用 Caddy）
NODEBB_PORT=4567

# 试跑阶段先走回环；将来挂子域名时改成 https://forum.1losion.me
# （NodeBB 会把这个地址写进 config，登录/WebSocket/上传链接都依赖它）
NODEBB_URL=http://127.0.0.1:4567

# 管理员账号：首次 setup 时创建。密码自己生成，别用弱口令：
#   openssl rand -base64 18
NODEBB_ADMIN_USER=kaznuadmin
NODEBB_ADMIN_PASSWORD=
NODEBB_ADMIN_EMAIL=admin@1losion.me

# 内存上限：这台 VPS 共 842MB / 可用 ~159MB，**千万别调大**
# 448m 是给"首次安装要跑 webpack 构建资产"留的余量；稳态可回落到 320m
NODEBB_MEM_LIMIT=448m
REDIS_MEM_LIMIT=160m
REDIS_MAXMEMORY=96mb

TZ=Asia/Almaty
