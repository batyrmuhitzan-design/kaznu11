# KazNU Helper 管理后台中文语言包（SQLAdmin 界面文案）
#
# SQLAdmin 0.31.1 只内置 en / de / az / ru / tr，没有中文，所以这份 catalog 由本仓库提供：
#   backend/app/i18n.py :: register_catalogs()  在 Admin(...) 构造前把它注册进
#   sqladmin.i18n.translations / SUPPORTED_LOCALES，使 ?lang=zh 生效。
#
# 修改后必须编译（.po → .mo），否则不生效：
#   python scripts/compile_admin_i18n.py
#
msgid ""
msgstr ""
"Project-Id-Version: KazNU Helper Admin\\n"
"Report-Msgid-Bugs-To: kaznu11\\n"
"MIME-Version: 1.0\\n"
"Content-Type: text/plain; charset=utf-8\\n"
"Content-Transfer-Encoding: 8bit\\n"
"Language: zh\\n"
"Language-Team: Chinese\\n"
"Plural-Forms: nplurals=1; plural=0;\\n"

