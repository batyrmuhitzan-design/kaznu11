# =============================================================================
# KazNU Helper — 服务器环境变量（/opt/kaznu11/.env）
# 统一域名：https://1losion.me （前端 App 与后端 API 都走这个域名）
# =============================================================================

# ---- 1) 前端 / App 打包变量 ----
VITE_API_URL=https://1losion.me
VITE_GPA_API_URL=
VITE_STUDENT_ID=20260001

# ---- 2) 数据库（PostgreSQL）----
POSTGRES_USER=kaznu
POSTGRES_PASSWORD=kaznu_postgres_2026
POSTGRES_DB=kaznu_helper
# 仅供本地（非 Docker）直接跑后端使用；Docker 环境由 docker-compose 用上面的变量覆盖
DATABASE_URL=postgresql+asyncpg://kaznu:kaznu_postgres_2026@localhost:5432/kaznu_helper

# ---- 3) 后端 ----
DEBUG=false
DB_ECHO=false
DEMO_PASSWORD=123456
DEMO_ALL_PASSWORD=true
ANON_HASH_SECRET=kaznu11-test-7f3a9c1e-please-change
SEED_ON_STARTUP=true
CORS_ORIGINS=*

# ---- 4) 管理后台 / 超级管理员（临时测试账号）----
SUPER_ADMIN_USERNAME=admin@1losion.me
SUPER_ADMIN_PASSWORD=admin123456
ADMIN_SESSION_SECRET=kaznu11-admin-session-secret-change-me
